# ==============================================================================
# JetOrt - NVIDIA Jetson (JetPack 5/6, Tegra Orin / Nano / Xavier) Container
# ==============================================================================
FROM nvcr.io/nvidia/l4t-base:r36.2.0 AS builder

WORKDIR /build
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    pkg-config \
    libssl-dev \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

COPY Cargo.toml Cargo.lock ./
COPY src ./src

# Jetson Orin compute capability 8.7. build.rs records JETORT_CUDA_ARCH.
ENV JETORT_CUDA_ARCH=87
ENV TARGET_CUDA_ARCH=87
ENV CMAKE_CUDA_ARCHITECTURES=87
RUN cargo build --release --no-default-features --features cuda,tensorrt

# Runtime Stage
FROM nvcr.io/nvidia/l4t-base:r36.2.0

WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/jetort /app/jetort
COPY config.yaml /app/config.yaml

EXPOSE 8080

ENTRYPOINT ["/app/jetort"]
CMD ["--config", "/app/config.yaml"]
